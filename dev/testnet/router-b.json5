{
  mode: "router",
  listen: { endpoints: ["tcp/0.0.0.0:7447"] },
  connect: { endpoints: ["tcp/router-a:7447"] },
  adminspace: { enabled: true, permissions: { read: true, write: false } },
  plugins: {
    rest: { http_port: 8000 },
    storage_manager: {
      storages: {
        telemetry: { key_expr: "fleet/*/telemetry/**", volume: "memory" },
      },
    },
  },
}
