{
  "name": "zenoh-explorer",
  "private": true,
  "version": "0.1.2",
  "license": "Apache-2.0",
  "type": "module",
  "description": "A modern explorer for Zenoh networks.",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "bindings": "cargo test --workspace export_bindings",
    "build": "tauri build",
    "build:e2e": "tauri build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "build:vite": "vite build",
    "capture": "pnpm build:e2e && wdio run wdio.capture.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm rust:lint && pnpm rust:test",
    "dev": "tauri dev",
    "dev:vite": "vite",
    "e2e": "pnpm build:e2e && pnpm test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "tauri icon design/icon.png",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "licenses:check": "node scripts/check-distribution-licenses.mjs",
    "licenses:generate": "node scripts/generate-distribution-licenses.mjs",
    "preview": "vite preview",
    "rust:fmt": "cargo fmt --all",
    "rust:lint": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "wdio run wdio.conf.ts",
    "test:rust": "cargo test --workspace",
    "test:watch": "vitest",
    "testnet": "docker compose -f dev/testnet/compose.yaml up -d",
    "testnet:down": "docker compose -f dev/testnet/compose.yaml down",
    "testnet:seed": "bash dev/testnet/seed.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/view": "^6.43.10",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@sigma/node-border": "3.0.0",
    "@sigma/utils": "3.0.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-deep-link": "^2.4.10",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-log": "^2.9.1",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "clsx": "^2.1.1",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "lucide-react": "^1.38.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sigma": "3.0.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "@wdio/cli": "^9.31.5",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.31.5",
    "@wdio/mocha-framework": "^9.31.5",
    "@wdio/spec-reporter": "^9.31.2",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "^1.3.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "happy-dom": "^20.12.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "serialize-javascript": "^7.1.1",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
