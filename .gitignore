# Rust
/target
**/target

# Node
node_modules
.pnpm-store

# Build output
/dist
/dist-ssr
*.local
*.tsbuildinfo

# Generated by each plugin's build.rs from its COMMANDS list
/crates/*/permissions/autogenerated
/crates/*/permissions/schemas

# Generated by Tauri from the capability files
/src-tauri/gen/schemas

# Generated TypeScript bindings (regenerate with `pnpm bindings`)
/src/ipc/generated

# Credentials. Nothing here should ever reach a commit: the explorer takes
# certificates as PATHS precisely so key material stays outside the project,
# but a stray copy while debugging a TLS connection is an easy mistake and an
# expensive one in a public repository.
*.pem
*.key
*.crt
*.cer
*.der
*.p12
*.pfx
*.jks
*.keystore
.env
.env.*
!.env.example

# Updater signing keys. `tauri signer generate` writes these; the private half
# belongs in the release runner's secrets, never in the tree.
*.key.pub
/.tauri

# Logs and local scratch
*.log
npm-debug.log*
pnpm-debug.log*

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db

# Design review screenshots, produced by `pnpm capture`
/design/captures

# Design-canvas scratch. The .dc.html sources are authored for another tool's
# parser and the page they seed is a ~2 MiB generated payload — neither belongs
# in the repo. The published canvas is the shareable artifact.
design/canvas
