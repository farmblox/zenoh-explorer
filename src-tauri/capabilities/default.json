{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Everything the main window is allowed to do. Publishing and deleting are granted here, but the window keeps them behind a per-session arming that defaults to off — a tool pointed at a live deployment should not be able to change it by a misplaced click.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-title",
    "core:webview:allow-internal-toggle-devtools",
    "zenoh-session:default",
    "zenoh-topology:default",
    "zenoh-keyspace:default",
    "zenoh-data:read-write",
    "zenoh-profiles:default",
    "os:default",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "dialog:allow-save",
    "dialog:allow-open",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "notification:default",
    "log:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://zenoh.io/*"
        },
        {
          "url": "https://docs.rs/*"
        },
        {
          "url": "https://github.com/eclipse-zenoh/*"
        }
      ]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$RESOURCE/licenses/DISTRIBUTION_LICENSES.txt"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$DOCUMENT/**"
        },
        {
          "path": "$CONFIG/**"
        }
      ]
    },
    "global-shortcut:default",
    "deep-link:default",
    "window-state:default"
  ]
}
