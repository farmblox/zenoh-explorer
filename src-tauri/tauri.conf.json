{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zenoh Explorer",
  "version": "../package.json",
  "identifier": "ag.farmblox.zenoh-explorer",
  "build": {
    "beforeDevCommand": "pnpm dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Zenoh Explorer",
        "width": 1440,
        "height": 940,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 19,
          "y": 24
        },
        "backgroundColor": "#0a0c0f"
      }
    ],
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": {
        "default-src": "'self'",
        "worker-src": "'self' blob:",
        "img-src": "'self' asset: http://asset.localhost data:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "copyright": "Copyright © 2026 Farmblox Inc.",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "../NOTICE": "licenses/NOTICE",
      "../DISTRIBUTION_LICENSES.txt": "licenses/DISTRIBUTION_LICENSES.txt"
    },
    "shortDescription": "Explore Zenoh networks",
    "longDescription": "A modern explorer for Zenoh networks: live topology, key-space browsing, key-expression testing and live data taps.",
    "linux": {
      "appimage": {
        "files": {
          "/usr/share/licenses/zenoh-explorer/LICENSE": "../LICENSE",
          "/usr/share/licenses/zenoh-explorer/NOTICE": "../NOTICE",
          "/usr/share/licenses/zenoh-explorer/DISTRIBUTION_LICENSES.txt": "../DISTRIBUTION_LICENSES.txt"
        }
      },
      "deb": {
        "files": {
          "/usr/share/doc/zenoh-explorer/copyright": "../DISTRIBUTION_LICENSES.txt",
          "/usr/share/doc/zenoh-explorer/NOTICE": "../NOTICE"
        }
      },
      "rpm": {
        "files": {
          "/usr/share/licenses/zenoh-explorer/LICENSE": "../LICENSE",
          "/usr/share/licenses/zenoh-explorer/NOTICE": "../NOTICE",
          "/usr/share/licenses/zenoh-explorer/DISTRIBUTION_LICENSES.txt": "../DISTRIBUTION_LICENSES.txt"
        }
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zenoh-explorer"]
      }
    }
  }
}
